# ─────────────────────────────────────────────────────────────────────────────
# Hub Vagas — variáveis de ambiente
#
# Como usar:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha com suas credenciais reais
#   3. NUNCA versione o arquivo .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Desenvolvimento local ─────────────────────────────────────────────────────
# Use estas variáveis para rodar o projeto localmente.
DB_USER=postgres
DB_PASSWORD=admin@123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_market

# ── Produção (Render) ─────────────────────────────────────────────────────────
# No Render, DATABASE_URL é injetada automaticamente pelo render.yaml.
# Não precisa definir aqui — o Render cuida disso via Blueprint.
# Formato para referência:
# DATABASE_URL=postgresql://hub_user:SENHA@HOST:5432/hub_vagas

# ── GitHub Pages ──────────────────────────────────────────────────────────────
# URL pública do dashboard após publicação.
# Formato: https://<seu-usuario>.github.io/<repositorio>
DASHBOARD_URL=https://willian-cruz.github.io/hub_vagas
