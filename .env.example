# ── Desenvolvimento local ─────────────────────────────────────
# Use estas variáveis para rodar o projeto localmente.
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hub_vagas
