# ─────────────────────────────────────────────────────────────
# Hub Vagas — variáveis de ambiente
#
# Como usar:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha com suas credenciais reais
#   3. NUNCA versione o arquivo .env
# ─────────────────────────────────────────────────────────────

# ── Desenvolvimento local ─────────────────────────────────────
# Use estas variáveis para rodar o projeto localmente.
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hub_vagas
# Opcional para bancos que exigem TLS: DB_SSLMODE=require

# Opcional: bundle CA para redes com proxy corporativo; TLS permanece validado.
# REQUESTS_CA_BUNDLE=C:/certs/proxy-ca.pem

# ── Notificação de falha (opcional) ───────────────────────────
# Webhook Discord ou Telegram para avisos de falha do pipeline.
# NOTIFICACAO_WEBHOOK_URL=https://...

# SMTP (alternativa ao webhook)
# SMTP_HOST=smtp.seudominio.com
# SMTP_PORT=587
# SMTP_USER=seu_usuario
# SMTP_PASS=sua_senha
# NOTIFICACAO_EMAIL_FROM=hub-vagas@seudominio.com
# NOTIFICACAO_EMAIL_TO=dev@seudominio.com
