# ─────────────────────────────────────────────────────────────
# Hub Vagas — variáveis de ambiente
#
# Como usar:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha com suas credenciais reais
#   3. NUNCA versione o arquivo .env
# ─────────────────────────────────────────────────────────────

# ── Desenvolvimento local ─────────────────────────────────────
# Use estas variáveis para rodar o projeto localmente.
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hub_vagas

# ── Produção (Cloud Run + Cloud SQL) ─────────────────────────
# No Cloud Run, a DATABASE_URL é injetada automaticamente
# pelo Secret Manager — não precisa definir aqui.
# Formato para referência:
# DATABASE_URL=postgresql://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE

# ── GitHub Pages ──────────────────────────────────────────────
# URL pública do dashboard após publicação no GitHub Pages.
# Formato: https://<seu-usuario>.github.io/<repositorio>
DASHBOARD_URL=
