+++ b/app/tests/test_job_repository.py
@@ -0,0 +1,97 @@
+"""
+Testes do JobRepository.salvar().
+
+O PipelineService depende do valor retornado ("salva", "duplicada" ou "erro")
+para montar as métricas da execução. Estes testes garantem esse contrato
+sem precisar de um banco PostgreSQL: a sessão do SQLAlchemy é um mock.
+"""
+from unittest.mock import patch
+
+import pytest
+from sqlalchemy.exc import IntegrityError
+
+from repositories import job_repository
+from repositories.job_repository import JobRepository, SALVA, DUPLICADA, ERRO
+from schemas.job_schema import JobSchema
+
+
+@pytest.fixture
+def vaga():
+    return JobSchema(
+        titulo="Engenheiro de Dados Jr",
+        empresa="Acme",
+        senioridade="Júnior",
+        localizacao="São Paulo - SP",
+        descricao="Python e SQL. Salário R$ 5.000",
+        link="https://exemplo.com/vaga/1",
+        origem="Vagas.com",
+    )
+
+
+@pytest.fixture
+def sessao():
+    """Substitui sessão, modelos e extração de tecnologias por mocks."""
+    with patch.object(job_repository, "SessionLocal") as session_local, \
+         patch.object(job_repository, "Job") as job_cls, \
+         patch.object(job_repository, "Technology"), \
+         patch.object(
+             job_repository.TechnologyService, "extrair", return_value=["Python", "SQL"]
+         ):
+        session = session_local.return_value
+        # Por padrão nenhuma vaga nem tecnologia existe no banco.
+        session.query.return_value.filter.return_value.first.return_value = None
+        session.job_cls = job_cls
+        yield session
+
+
+def test_vaga_nova_retorna_salva(sessao, vaga):
+    assert JobRepository.salvar(vaga) == SALVA
+    sessao.commit.assert_called_once()
+    sessao.rollback.assert_not_called()
+
+
+def test_vaga_nova_grava_dados_da_vaga(sessao, vaga):
+    JobRepository.salvar(vaga)
+
+    campos = sessao.job_cls.call_args.kwargs
+    assert campos["titulo"] == vaga.titulo
+    assert campos["link"] == vaga.link
+    assert campos["origem"] == "Vagas.com"
+
+
+def test_vaga_nova_vincula_uma_tecnologia_por_nome(sessao, vaga):
+    JobRepository.salvar(vaga)
+
+    nova_vaga = sessao.job_cls.return_value
+    assert nova_vaga.technologies.append.call_count == 2
+
+
+def test_vaga_existente_retorna_duplicada_sem_gravar(sessao, vaga):
+    sessao.query.return_value.filter.return_value.first.return_value = object()
+
+    assert JobRepository.salvar(vaga) == DUPLICADA
+    sessao.add.assert_not_called()
+    sessao.commit.assert_not_called()
+
+
+def test_violacao_de_unicidade_no_commit_retorna_duplicada(sessao, vaga):
+    sessao.commit.side_effect = IntegrityError("INSERT", {}, Exception("link duplicado"))
+
+    assert JobRepository.salvar(vaga) == DUPLICADA
+    sessao.rollback.assert_called_once()
+
+
+def test_erro_inesperado_retorna_erro_e_faz_rollback(sessao, vaga):
+    sessao.commit.side_effect = RuntimeError("conexão perdida")
+
+    assert JobRepository.salvar(vaga) == ERRO
+    sessao.rollback.assert_called_once()
+
+
+@pytest.mark.parametrize("falha", [None, IntegrityError("INSERT", {}, Exception("x")), RuntimeError("x")])
+def test_sessao_e_sempre_fechada(sessao, vaga, falha):
+    sessao.commit.side_effect = falha
+
+    JobRepository.salvar(vaga)
+
+    sessao.close.assert_called_once()
